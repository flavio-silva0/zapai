# ============================================================
# ZapAI — Variáveis de Ambiente (Template / .env.example)
# Copie este arquivo para .env e preencha com suas credenciais.
# NUNCA comite o arquivo .env preenchido no controle de versão.
# ============================================================

# ── Servidor e Porta ─────────────────────────────────────────
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://zapai.com.br

# ── Autenticação e Segurança ──────────────────────────────────
# Gere uma chave segura de 32 bytes (64 caracteres hex):
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=substitua_por_uma_chave_secreta_longa_e_aleatoria_32_bytes

# ── Supabase (PostgreSQL & PostgREST API) ───────────────────────
# URL do projeto no Supabase (ex: https://xyzcompany.supabase.co)
SUPABASE_URL=https://seu-projeto.supabase.co
# Service Role Key (com permissão de bypass RLS para operações internas do backend)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Google Gemini IA ──────────────────────────────────────────
# Chave de API corporativa / AI Studio
GEMINI_API_KEY=AIzaSy...
# Modelo principal de atendimento
GEMINI_MODEL=gemini-3.5-flash-lite
# Modelo de fallback em caso de indisponibilidade ou rate limit (AI-002)
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
# Modelo de embeddings para RAG vetorial
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
TIMEOUT_GEMINI_MS=25000

# ── WhatsApp Meta Cloud API v20.0 ─────────────────────────────
# Token configurado no Meta for Developers para verificação do Webhook GET
META_VERIFY_TOKEN=sua_frase_secreta_de_verificacao_webhook
# Segredo do App Meta (App Secret) para verificação de assinatura HMAC SHA-256 (WA-001)
META_APP_SECRET=seu_meta_app_secret_hex

# ── Parâmetros de Mensageria e Humanização ─────────────────────
HISTORICO_LIMITE=20
DEBOUNCE_MS=7500
DELAY_MINIMO_MS=2500
DELAY_MAXIMO_MS=7000
MS_POR_PALAVRA=70
WHATSAPP_MAX_CHARS=400
WHATSAPP_MAX_MESSAGES=3
DELAY_ENTRE_MENSAGENS_MIN_MS=800
DELAY_ENTRE_MENSAGENS_MAX_MS=1600

# ── Controle de Custos e Rate Limiting ────────────────────────
# Teto de chamadas de IA por tenant por minuto (COST-001)
AI_QUOTA_PER_MINUTE=60

# ── Modo de Testes (Apenas desenvolvimento/CI) ─────────────────
# TEST_MODE=false
# USE_REAL_GEMINI=false
